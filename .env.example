# Copy to .env and fill in — this is the only configuration required.

# Google AI Studio (Gemini API, free tier) key.
# Used for: Understand extraction, Recommend drafting, Verify vision checks,
# and text-embedding-004 embeddings.
GEMINI_API_KEY=

# Demo replay mode: 1 = consult the recorded fixture store before calling live
# Gemini (rate-limit protection for the rehearsed demo path), 0 = always live.
DEMO_REPLAY=0
