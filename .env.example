# Copy to .env and fill in — this is the only configuration required.

# Google AI Studio (Gemini API, free tier) key.
# Used for: Understand extraction, Recommend drafting, Verify vision checks,
# and text-embedding-004 embeddings.
GEMINI_API_KEY=

# Demo replay mode: 1 = consult the recorded fixture store before calling live
# Gemini (rate-limit protection for the rehearsed demo path), 0 = always live.
DEMO_REPLAY=0

# LLM provider (default: gemini). To run on a local/sovereign model instead,
# point at any OpenAI-compatible server (Ollama, vLLM, llama.cpp, a gateway):
# LLM_PROVIDER=openai_compat
# LLM_BASE_URL=http://host.docker.internal:11434/v1
# LLM_MODEL=qwen2.5:7b
# EMBED_MODEL=nomic-embed-text   # must produce 768-dim vectors
# LLM_API_KEY=                   # optional for local servers
